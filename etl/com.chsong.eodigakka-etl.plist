<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
eodigakka 일일 RTMS ETL — 매일 03:00 KST
설치:
  cp etl/com.chsong.eodigakka-etl.plist ~/Library/LaunchAgents/
  launchctl load ~/Library/LaunchAgents/com.chsong.eodigakka-etl.plist
중단:
  launchctl unload ~/Library/LaunchAgents/com.chsong.eodigakka-etl.plist
즉시 1회 실행:
  launchctl start com.chsong.eodigakka-etl
상태 확인:
  launchctl list | grep eodigakka
  tail -f /Users/chsong/Documents/sidespace/projects/eodigakka/logs/etl-$(date +%Y%m%d).log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chsong.eodigakka-etl</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/chsong/Documents/sidespace/projects/eodigakka/etl/run_etl.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/chsong/Documents/sidespace/projects/eodigakka</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/chsong/Documents/sidespace/projects/eodigakka/logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/chsong/Documents/sidespace/projects/eodigakka/logs/launchd-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
